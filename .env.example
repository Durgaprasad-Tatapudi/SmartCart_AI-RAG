# ==============================================================================
# SmartCart AI-RAG — Environment Configuration Template
# Copy this file to `.env` (or `backend/.env`) and fill in your actual credentials.
# NEVER commit your actual `.env` file containing real API keys to version control.
# ==============================================================================

# --- Frontend Configuration (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Backend Configuration (FastAPI) ---
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# --- OpenRouter LLM API Configuration ---
# Obtain your free or paid API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto

# --- Qdrant Vector Database ---
# Local embedded vector storage is automatically used if Qdrant server is not running
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smartcart_products

# --- Multilingual Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Relational Database (SQLite) ---
DATABASE_URL=sqlite:///./smartcart.db
